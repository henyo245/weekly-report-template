# 環境変数のテンプレート
# .env ファイルとしてコピーして使用してください

# GitHub Personal Access Token
# https://github.com/settings/tokens で生成してください
GITHUB_TOKEN=your_token_here

# GitHub リポジトリオーナー/リポジトリ名
GITHUB_REPO=your_username/your_repository

# GitHub Projects の番号
# リポジトリの Projects タブから確認できます
PROJECT_NUMBER=1

# オプション: 出力ファイルのパス
REPORT_OUTPUT_DIR=./data/reports

# オプション: タスク日データの保存パス
TASKS_DATA_DIR=./data
